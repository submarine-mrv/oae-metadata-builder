# Auth is off unless VITE_AUTH_ENABLED=true. See "Auth" in README.md.
VITE_AUTH_ENABLED=true
# supabase (default) or memory, an in-browser fake for e2e tests and demos.
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# GA4 measurement ID. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=
